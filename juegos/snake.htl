<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Snake - Sergio's Arcade</title>
    <style>
        body { background: #1a1a2e; color: white; display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; font-family: 'Segoe UI', sans-serif; }
        canvas { background: #0f0f1a; border: 2px solid #667eea; border-radius: 8px; box-shadow: 0 0 20px rgba(102,126,234,0.3); }
        .ui { text-align: center; margin-bottom: 20px; }
        .score { font-size: 2rem; font-weight: bold; color: #667eea; }
        .btn { background: #667eea; color: white; border: none; padding: 10px 20px; border-radius: 5px; cursor: pointer; margin-top: 10px; font-size: 1rem; }
        a { color: #aaa; text-decoration: none; margin-top: 20px; display: inline-block; }
    </style>
</head>
<body>
    <div class="ui">
        <div class="score">Puntos: <span id="score">0</span></div>
        <button class="btn" onclick="startGame()">▶ Iniciar / Reiniciar</button>
    </div>
    <canvas id="game" width="400" height="400"></canvas>
    <a href="juegos.html">← Volver al Menú</a>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
        import { getFirestore, addDoc, collection } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

        const firebaseConfig = { apiKey: "AIzaSyBmTBMyE7Y_LgSXH1SrmEv29DLYdxkyUEw", authDomain: "compartir-textos-app.firebaseapp.com", projectId: "compartir-textos-app", storageBucket: "compartir-textos-app.firebasestorage.app", messagingSenderId: "705083380628", appId: "1:705083380628:web:ce267570e09e3ef1b27581" };
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        
        let currentUser = null;
        onAuthStateChanged(auth, (user) => { if(user) currentUser = user; else window.location.href = '../index.html'; });

        const canvas = document.getElementById('game');
        const ctx = canvas.getContext('2d');
        const gridSize = 20;
        let snake = [{x: 10, y: 10}];
        let food = {x: 15, y: 15};
        let dx = 0, dy = 0;
        let score = 0;
        let gameInterval;
        let isPlaying = false;

        window.startGame = function() {
            snake = [{x: 10, y: 10}];
            dx = 1; dy = 0;
            score = 0;
            document.getElementById('score').innerText = score;
            placeFood();
            if(gameInterval) clearInterval(gameInterval);
            isPlaying = true;
            gameInterval = setInterval(update, 100);
        }

        function update() {
            if(!isPlaying) return;
            const head = {x: snake[0].x + dx, y: snake[0].y + dy};
            
            // Colisión paredes o consigo mismo
            if(head.x < 0 || head.x >= 20 || head.y < 0 || head.y >= 20 || snake.some(s => s.x === head.x && s.y === head.y)) {
                gameOver();
                return;
            }

            snake.unshift(head);
            if(head.x === food.x && head.y === food.y) {
                score += 10;
                document.getElementById('score').innerText = score;
                placeFood();
            } else {
                snake.pop();
            }
            draw();
        }

        function draw() {
            ctx.fillStyle = '#0f0f1a';
            ctx.fillRect(0, 0, 400, 400);
            
            ctx.fillStyle = '#667eea';
            snake.forEach(s => ctx.fillRect(s.x * gridSize, s.y * gridSize, gridSize-2, gridSize-2));
            
            ctx.fillStyle = '#ff5252';
            ctx.fillRect(food.x * gridSize, food.y * gridSize, gridSize-2, gridSize-2);
        }

        function placeFood() {
            food = { x: Math.floor(Math.random() * 20), y: Math.floor(Math.random() * 20) };
        }

        async function gameOver() {
            isPlaying = false;
            clearInterval(gameInterval);
            alert(`¡Juego terminado! Puntuación: ${score}`);
            if(currentUser && score > 0) {
                await addDoc(collection(db, "scores"), { userId: currentUser.uid, gameId: 'snake', score, timestamp: new Date() });
            }
        }

        document.addEventListener('keydown', e => {
            if(e.key === 'ArrowUp' && dy !== 1) { dx=0; dy=-1; }
            if(e.key === 'ArrowDown' && dy !== -1) { dx=0; dy=1; }
            if(e.key === 'ArrowLeft' && dx !== 1) { dx=-1; dy=0; }
            if(e.key === 'ArrowRight' && dx !== -1) { dx=1; dy=0; }
        });
    </script>
</body>
</html>
